{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "description": "Wait 3 days after a release before proposing it, then automerge everything.",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Never automerge a digest move: the tag stayed put but the commit it points at changed, so the code was never reviewed under that version.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/tasks/playwright\\.yml$/"
      ],
      "matchStrings": [
        "--from 'mysql-to-sqlite3==(?<currentValue>[^']+)'"
      ],
      "depNameTemplate": "mysql-to-sqlite3",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.tugboat/config\\.yml$/"
      ],
      "matchStrings": [
        "astral\\.sh/uv/(?<currentValue>[^/]+)/install\\.sh"
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^package\\.json$/",
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "mkdocs@(?<currentValue>[^\\s\"']+)"
      ],
      "depNameTemplate": "mkdocs",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "mike@(?<currentValue>[^\\s\"']+)"
      ],
      "depNameTemplate": "mike",
      "datasourceTemplate": "pypi"
    }
  ]
}
