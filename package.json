{
  "name": "@lullabot/playwright-drupal",
  "version": "1.16.1",
  "description": "Playwright / Drupal integration, supporting fast parallel tests and visual comparisons",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "lib/",
    "src/",
    "bin/",
    "settings/",
    "tasks/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace=@lullabot/playwright-testing && tsc",
    "build:all": "npm run build && npm run build --workspaces --if-present",
    "prepack": "npm run build",
    "prepare": "husky || true",
    "test": "npm run test:unit && npm run test:bats",
    "test:all": "npm test && npm test --workspaces --if-present",
    "pretest:unit": "npm run build --workspace=@lullabot/playwright-testing",
    "test:unit": "vitest run",
    "test:autofocus": "npm run test:autofocus --workspace=@lullabot/playwright-testing && npm run test:autofocus:drupal",
    "test:autofocus:drupal": "playwright test --config tests/webkit-autofocus/playwright.config.ts",
    "test:bats": "bats test/",
    "docs:dev": "uvx --with-requirements docs/requirements.txt mkdocs@1.6.1 serve",
    "docs:build": "uvx --with-requirements docs/requirements.txt mkdocs@1.6.1 build --strict",
    "docs:preview": "uvx --with-requirements docs/requirements.txt mkdocs@1.6.1 serve site/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts}\" \"**/bin/github-*\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts}\" \"**/bin/github-*\""
  },
  "author": "Andrew Berry <andrew.berry@lullabot.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lullabot/playwright-drupal.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "playwright-drupal-a11y-summary": "bin/github-a11y-summary",
    "playwright-drupal-mutex": "bin/playwright-mutex",
    "playwright-drupal-failure-summary": "bin/github-failure-summary"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./github/a11y-summary": {
      "types": "./lib/github/a11y-summary.d.ts",
      "default": "./lib/github/a11y-summary.js"
    },
    "./github/failure-summary": {
      "types": "./lib/github/failure-summary.d.ts",
      "default": "./lib/github/failure-summary.js"
    },
    "./github/attachments": {
      "types": "./lib/github/attachments.d.ts",
      "default": "./lib/github/attachments.js"
    }
  },
  "dependencies": {
    "@lullabot/playwright-testing": "1.2.1",
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.39.0",
    "@types/node": "^24.0.0",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/shell-quote": "^1.7.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2 || ^6.0.0 || ^7.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
